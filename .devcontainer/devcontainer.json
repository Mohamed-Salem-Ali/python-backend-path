{
  // Open the course ready to run, in GitHub Codespaces or in VS Code with the Dev Containers
  // extension. Python 3.12, the course tools, and each project's requirements in its own .venv,
  // the same layout the week 5 and week 10 setup steps create.
  "name": "Python Backend Path",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "runserver / uvicorn" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
